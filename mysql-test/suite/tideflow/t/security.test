#
# Hostile identifiers and missing privileges: the maintenance procedures and
# UDFs, and INFORMATION_SCHEMA.TIDEFLOW_*. Everything must fail cleanly, and
# no other table or file may be touched.
#
--source include/not_embedded.inc
--source include/have_sequence.inc
--source suite/tideflow/include/have_tideflow.inc
let MYSQLD_DATADIR= `SELECT @@datadir`;

SET NAMES utf8mb4;
CREATE DATABASE sec CHARACTER SET utf8mb4;
--echo # (installed from a utf8mb4 client; see bug_proc_nonascii_name.test for latin1)
--exec $MYSQL --default-character-set=utf8mb4 sec < $TIDEFLOW_INSTALL_SQL
USE sec;
CREATE TABLE victim (ts DATETIME NOT NULL, v INT, INDEX(ts)) ENGINE=TideFlow RETENTION_PERIOD='30 DAYS';
INSERT INTO victim SELECT '2001-01-01' + INTERVAL seq DAY, seq FROM seq_1_to_20;
FLUSH TABLES victim;
INSERT INTO victim VALUES ('2002-01-01', 99);
CREATE TABLE sibling (ts DATETIME NOT NULL, v INT, INDEX(ts)) ENGINE=TideFlow;
INSERT INTO sibling VALUES (NOW(), 1);
CREATE TABLE myi (a INT) ENGINE=MyISAM;
INSERT INTO myi VALUES (1);
let $state= SELECT (SELECT COUNT(*) FROM victim) AS victim_rows, (SELECT COUNT(*) FROM sibling) AS sibling_rows,
  (SELECT COUNT(*) FROM myi) AS myi_rows, (SELECT COUNT(*) FROM mysql.user) > 0 AS users_ok,
  (SELECT CHUNKS FROM information_schema.TIDEFLOW_TABLES WHERE TABLE_SCHEMA = 'sec' AND TABLE_NAME = 'victim') AS victim_chunks;
eval $state;

--echo # ---- Procedure arguments that try to break out of the identifier ----
--echo # (only the error number is shown: 0 would mean the call was accepted)
--disable_abort_on_error
--disable_result_log
CALL tideflow_apply_retention('victim`; DROP TABLE victim; -- ');
--echo error: $mysql_errno
CALL tideflow_apply_retention('sec.victim` WHERE FALSE) ; DROP TABLE victim; -- ');
--echo error: $mysql_errno
CALL tideflow_apply_retention('../victim');
--echo error: $mysql_errno
CALL tideflow_apply_retention('..\\victim');
--echo error: $mysql_errno
CALL tideflow_apply_retention('sec.../victim');
--echo error: $mysql_errno
CALL tideflow_apply_retention('../sec/victim');
--echo error: $mysql_errno
CALL tideflow_apply_retention('./victim');
--echo error: $mysql_errno
CALL tideflow_apply_retention('victim/../sibling');
--echo error: $mysql_errno
CALL tideflow_apply_retention('/etc/passwd');
--echo error: $mysql_errno
CALL tideflow_apply_retention('mysql.user');
--echo error: $mysql_errno
CALL tideflow_apply_retention('mysql.');
--echo error: $mysql_errno
CALL tideflow_apply_retention('.victim');
--echo error: $mysql_errno
CALL tideflow_apply_retention('');
--echo error: $mysql_errno
CALL tideflow_apply_retention(NULL);
--echo error: $mysql_errno
CALL tideflow_apply_retention('a.b.c.victim');
--echo error: $mysql_errno
CALL tideflow_apply_retention('victim\0');
--echo error: $mysql_errno
CALL tideflow_apply_retention('"victim"');
--echo error: $mysql_errno
CALL tideflow_apply_retention('`victim`');
--echo error: $mysql_errno
CALL tideflow_apply_retention('victim\' OR \'1\'=\'1');
--echo error: $mysql_errno
CALL tideflow_apply_retention('nonexistent_db.victim');
--echo error: $mysql_errno
CALL tideflow_apply_retention('information_schema.TIDEFLOW_TABLES');
--echo error: $mysql_errno
CALL tideflow_apply_retention('myi');
--echo error: $mysql_errno
CALL tideflow_apply_retention(REPEAT('x', 129));
--echo error: $mysql_errno
CALL tideflow_apply_retention(CONCAT(REPEAT('d', 200), '.', REPEAT('t', 200)));
--echo error: $mysql_errno
CALL tideflow_compact('victim`; DROP TABLE victim; -- ', NULL, NULL);
--echo error: $mysql_errno
CALL tideflow_compact('../victim', NULL, NULL);
--echo error: $mysql_errno
CALL tideflow_compact('myi', NULL, NULL);
--echo error: $mysql_errno
CALL tideflow_compact('victim', 'DROP TABLE victim', NULL);
--echo error: $mysql_errno
CALL tideflow_compact('victim', '2001-01-01\'; DROP TABLE victim; --', NULL);
--echo error: $mysql_errno
CALL tideflow_compact('victim', NULL, 'not-a-date');
--echo error: $mysql_errno
CALL tideflow_compact('victim', '2026-13-45', NULL);
--echo error: $mysql_errno
CALL tideflow_compact('victim', '2026-01-01 25:61:61', NULL);
--echo error: $mysql_errno
CALL tideflow_compact('victim', '99999-01-01', NULL);
--echo error: $mysql_errno
CALL tideflow_compact('victim', '-2026-01-01', NULL);
--echo error: $mysql_errno
CALL tideflow_compact('victim', REPEAT('9', 5000), NULL);
--echo error: $mysql_errno
--enable_result_log
--enable_abort_on_error
--echo # Nothing else was touched
eval $state;
--sorted_result
--list_files $MYSQLD_DATADIR/sec victim*
--sorted_result
--list_files $MYSQLD_DATADIR/sec sibling*
--sorted_result
--list_files $MYSQLD_DATADIR/sec myi*

--echo # ---- UDFs called directly ----
--error ER_CANT_INITIALIZE_UDF
SELECT tideflow_compact_impl();
--error ER_CANT_INITIALIZE_UDF
SELECT tideflow_compact_impl('sec', 'victim');
--error ER_CANT_INITIALIZE_UDF
SELECT tideflow_retention_impl('sec');
--error ER_CANT_INITIALIZE_UDF
SELECT tideflow_retention_impl('sec', 'victim', 'extra');
--error ER_UNKNOWN_ERROR
SELECT tideflow_retention_impl(NULL, NULL);
--error ER_UNKNOWN_ERROR
SELECT tideflow_retention_impl('sec', NULL);
--error ER_UNKNOWN_ERROR
SELECT tideflow_compact_impl('sec', 'victim', 'bogus', '');
--error ER_UNKNOWN_ERROR
SELECT tideflow_retention_impl('../sec', 'victim');
--error ER_UNKNOWN_ERROR
SELECT tideflow_retention_impl('sec', '../sec/victim');
--error ER_UNKNOWN_ERROR
SELECT tideflow_retention_impl('sec', 'victim/../sibling');
--error ER_UNKNOWN_ERROR
SELECT tideflow_retention_impl(1, 2);
--error ER_UNKNOWN_ERROR
SELECT tideflow_retention_impl('', '');
--error ER_UNKNOWN_ERROR
SELECT tideflow_retention_impl(REPEAT('d', 100000), REPEAT('t', 100000));
--error ER_UNKNOWN_ERROR
SELECT tideflow_retention_impl('sec', 'myi');
--error ER_UNKNOWN_ERROR
SELECT tideflow_retention_impl('sec', 'never_existed');
--error ER_UNKNOWN_ERROR
SELECT tideflow_retention_impl(0x0000, 0xFF00FF);
eval $state;

--echo # ---- Odd but legal table names work end to end ----
CREATE TABLE `quo``te` (ts DATETIME NOT NULL, v INT, INDEX(ts)) ENGINE=TideFlow;
CREATE TABLE `with space` (ts DATETIME NOT NULL, v INT, INDEX(ts)) ENGINE=TideFlow;
CREATE TABLE `ünï-çødé` (ts DATETIME NOT NULL, v INT, INDEX(ts)) ENGINE=TideFlow;
CREATE TABLE `a@b` (ts DATETIME NOT NULL, v INT, INDEX(ts)) ENGINE=TideFlow;
CREATE TABLE `dot.dot` (ts DATETIME NOT NULL, v INT, INDEX(ts)) ENGINE=TideFlow;
CREATE TABLE `#hash` (ts DATETIME NOT NULL, v INT, INDEX(ts)) ENGINE=TideFlow;
CREATE TABLE `$dollar` (ts DATETIME NOT NULL, v INT, INDEX(ts)) ENGINE=TideFlow;
CREATE TABLE `UPPER_lower` (ts DATETIME NOT NULL, v INT, INDEX(ts)) ENGINE=TideFlow;
--error ER_WRONG_TABLE_NAME
CREATE TABLE `trailing ` (ts DATETIME NOT NULL, v INT, INDEX(ts)) ENGINE=TideFlow;
--error ER_WRONG_TABLE_NAME
CREATE TABLE `` (ts DATETIME NOT NULL, v INT, INDEX(ts)) ENGINE=TideFlow;
let $maxname= `SELECT REPEAT('n', 64)`;
eval CREATE TABLE `$maxname` (ts DATETIME NOT NULL, v INT, INDEX(ts)) ENGINE=TideFlow;
let $toolong= `SELECT REPEAT('n', 65)`;
--error ER_WRONG_TABLE_NAME
eval CREATE TABLE `$toolong` (ts DATETIME NOT NULL, v INT, INDEX(ts)) ENGINE=TideFlow;
INSERT INTO `quo``te` VALUES ('2026-01-01', 1);
INSERT INTO `with space` VALUES ('2026-01-02', 2);
INSERT INTO `ünï-çødé` VALUES ('2026-01-03', 3);
INSERT INTO `a@b` VALUES ('2026-01-04', 4);
INSERT INTO `dot.dot` VALUES ('2026-01-05', 5);
INSERT INTO `#hash` VALUES ('2026-01-06', 6);
INSERT INTO `$dollar` VALUES ('2026-01-07', 7);
INSERT INTO `UPPER_lower` VALUES ('2026-01-08', 8);
eval INSERT INTO `$maxname` VALUES ('2026-01-09', 9);
FLUSH TABLES;
SELECT (SELECT v FROM `quo``te`) + (SELECT v FROM `with space`) + (SELECT v FROM `ünï-çødé`) + (SELECT v FROM `a@b`)
  + (SELECT v FROM `dot.dot`) + (SELECT v FROM `#hash`) + (SELECT v FROM `$dollar`) + (SELECT v FROM `UPPER_lower`) AS sum_1_to_8;
eval SELECT v FROM `$maxname`;
SELECT TABLE_NAME, ROW_COUNT FROM information_schema.TIDEFLOW_TABLES WHERE TABLE_SCHEMA = 'sec'
  AND TABLE_NAME NOT LIKE 'nnnn%' ORDER BY TABLE_NAME;
SELECT COUNT(*) FROM information_schema.TIDEFLOW_TABLES WHERE TABLE_SCHEMA = 'sec' AND TABLE_NAME = REPEAT('n', 64);

--echo # The procedures reach them too (quoting is applied to the whole name)
CALL tideflow_apply_retention('quo`te');
CALL tideflow_apply_retention('sec.quo`te');
CALL tideflow_apply_retention('with space');
CALL tideflow_apply_retention('ünï-çødé');
CALL tideflow_compact('a@b', NULL, NULL);
CALL tideflow_compact('#hash', '2026-01-01', '2026-12-31');
CALL tideflow_compact('$dollar', '2026-01-01 00:00:00.5', NULL);
--echo # A dot in the table name is ambiguous for the 'db.table' form
--disable_abort_on_error
--disable_result_log
CALL tideflow_apply_retention('dot.dot');
--echo error: $mysql_errno
CALL tideflow_apply_retention('sec.dot.dot');
--echo error: $mysql_errno
--enable_result_log
--enable_abort_on_error
OPTIMIZE TABLE `dot.dot`;
SELECT * FROM `dot.dot`;
RENAME TABLE `with space` TO `renamed ok`, `a@b` TO `a@c`;
SELECT v FROM `renamed ok`;
SELECT v FROM `a@c`;
--error ER_NO_SUCH_TABLE
SELECT v FROM `a@b`;
eval $state;

--echo # ---- Privileges ----
CREATE USER 'plain'@'localhost';
CREATE USER 'proc'@'localhost';
CREATE USER 'reader'@'localhost';
CREATE USER 'writer'@'localhost';
GRANT PROCESS ON *.* TO 'proc'@'localhost';
GRANT SELECT ON sec.victim TO 'reader'@'localhost';
GRANT SELECT, INSERT ON sec.victim TO 'writer'@'localhost';
GRANT EXECUTE ON PROCEDURE sec.tideflow_compact TO 'plain'@'localhost';
GRANT EXECUTE ON PROCEDURE sec.tideflow_apply_retention TO 'plain'@'localhost';
GRANT EXECUTE ON PROCEDURE sec.tideflow_compact TO 'reader'@'localhost';
GRANT EXECUTE ON PROCEDURE sec.tideflow_apply_retention TO 'reader'@'localhost';
GRANT EXECUTE ON PROCEDURE sec.tideflow_compact TO 'writer'@'localhost';
GRANT EXECUTE ON PROCEDURE sec.tideflow_apply_retention TO 'writer'@'localhost';
GRANT EXECUTE ON PROCEDURE sec.tideflow_compact TO 'proc'@'localhost';
GRANT EXECUTE ON PROCEDURE sec.tideflow_apply_retention TO 'proc'@'localhost';

--echo # No PROCESS: the views are empty; the engine does not widen any grant
connect (plain,localhost,plain,,);
SELECT COUNT(*) FROM information_schema.TIDEFLOW_TABLES;
SELECT COUNT(*) FROM information_schema.TIDEFLOW_CHUNKS;
SELECT COUNT(*) FROM information_schema.TIDEFLOW_TABLES WHERE TABLE_NAME = 'victim';
--error ER_TABLEACCESS_DENIED_ERROR
SELECT COUNT(*) FROM sec.victim;
--error ER_TABLEACCESS_DENIED_ERROR
CALL sec.tideflow_apply_retention('sec.victim');
--error ER_TABLEACCESS_DENIED_ERROR
CALL sec.tideflow_compact('sec.victim', NULL, NULL);
--error ER_TABLEACCESS_DENIED_ERROR
CALL sec.tideflow_compact('sec.sibling', NULL, NULL);
--error ER_TABLEACCESS_DENIED_ERROR
INSERT INTO sec.victim VALUES ('2026-01-01', 1);
--error ER_TABLEACCESS_DENIED_ERROR
TRUNCATE TABLE sec.victim;
--error ER_TABLEACCESS_DENIED_ERROR
OPTIMIZE TABLE sec.victim;
--error ER_TABLEACCESS_DENIED_ERROR
DROP TABLE sec.victim;
--error ER_TABLEACCESS_DENIED_ERROR
RENAME TABLE sec.victim TO sec.stolen;
--error ER_TABLEACCESS_DENIED_ERROR
CREATE TABLE sec.mine (ts DATETIME NOT NULL, INDEX(ts)) ENGINE=TideFlow;
--echo # (direct UDF calls by unprivileged users: see bug_udf_privilege.test)
disconnect plain;

--echo # PROCESS grants the views, not the data
connect (proc,localhost,proc,,);
SELECT TABLE_NAME FROM information_schema.TIDEFLOW_TABLES WHERE TABLE_SCHEMA = 'sec' AND TABLE_NAME IN ('victim', 'sibling') ORDER BY TABLE_NAME;
SELECT COUNT(*) > 0 FROM information_schema.TIDEFLOW_CHUNKS WHERE TABLE_SCHEMA = 'sec' AND TABLE_NAME = 'victim';
--error ER_TABLEACCESS_DENIED_ERROR
SELECT COUNT(*) FROM sec.victim;
--error ER_TABLEACCESS_DENIED_ERROR
CALL sec.tideflow_apply_retention('sec.victim');
disconnect proc;

--echo # SELECT only: reads work, nothing else
connect (reader,localhost,reader,,);
SELECT COUNT(*) FROM sec.victim;
--error ER_TABLEACCESS_DENIED_ERROR
INSERT INTO sec.victim VALUES ('2026-01-01', 1);
--error ER_TABLEACCESS_DENIED_ERROR
TRUNCATE TABLE sec.victim;
--error ER_TABLEACCESS_DENIED_ERROR
SELECT COUNT(*) FROM sec.sibling;
--error ER_TABLEACCESS_DENIED_ERROR
CALL sec.tideflow_compact('sec.sibling', NULL, NULL);
--echo # ... but the procedures act with the invoker's rights, which include SELECT
CALL sec.tideflow_compact('sec.victim', NULL, NULL);
SELECT COUNT(*) FROM sec.victim;
disconnect reader;

--echo # INSERT lands; DELETE/UPDATE need their own privilege
connect (writer,localhost,writer,,);
INSERT INTO sec.victim VALUES ('2026-01-01', 1000);
--error ER_TABLEACCESS_DENIED_ERROR
DELETE FROM sec.victim;
--error ER_TABLEACCESS_DENIED_ERROR
UPDATE sec.victim SET v = 0;
disconnect writer;
connection default;
SELECT COUNT(*), MAX(v) FROM victim;

DROP USER 'plain'@'localhost', 'proc'@'localhost', 'reader'@'localhost', 'writer'@'localhost';

--echo # ---- Cleanup ----
USE test;
DROP DATABASE sec;
DROP FUNCTION tideflow_compact_impl;
DROP FUNCTION tideflow_retention_impl;
