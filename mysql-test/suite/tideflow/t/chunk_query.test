#
# Index (timestamp range) scans across MemTable and sealed chunks.
#
--source suite/tideflow/include/have_tideflow.inc

CREATE TABLE m (
    ts     DATETIME(6) NOT NULL,
    host   VARCHAR(16) NOT NULL COMMENT 'TAG',
    metric VARCHAR(16) NOT NULL COMMENT 'TAG',
    value  DOUBLE,
    INDEX ts_idx (ts)
) ENGINE=TideFlow CHUNK_INTERVAL='1 HOUR';

--echo # 3 hosts x 2 metrics x 240 minutes, written in two batches with a flush
--echo # in between so data spans several chunks and the MemTable.
--disable_query_log
let $i= 0;
while ($i < 240)
{
  eval INSERT INTO m VALUES
    ('2026-10-01 00:00:00' + INTERVAL $i MINUTE, 'srv01', 'cpu',  $i),
    ('2026-10-01 00:00:00' + INTERVAL $i MINUTE, 'srv02', 'cpu',  $i * 2),
    ('2026-10-01 00:00:00' + INTERVAL $i MINUTE, 'srv03', 'cpu',  $i * 3),
    ('2026-10-01 00:00:00' + INTERVAL $i MINUTE, 'srv01', 'mem',  1000 + $i),
    ('2026-10-01 00:00:00' + INTERVAL $i MINUTE, 'srv02', 'mem',  2000 + $i),
    ('2026-10-01 00:00:00' + INTERVAL $i MINUTE, 'srv03', 'mem',  3000 + $i);
  if ($i == 150)
  {
    FLUSH TABLES m;
  }
  inc $i;
}
--enable_query_log

SELECT COUNT(*), MIN(ts), MAX(ts) FROM m;

--echo # Range on the timestamp index
--replace_column 9 #
EXPLAIN SELECT * FROM m WHERE ts BETWEEN '2026-10-01 01:00:00' AND '2026-10-01 01:04:00';
SELECT * FROM m WHERE ts BETWEEN '2026-10-01 01:00:00' AND '2026-10-01 01:01:00' ORDER BY ts, host, metric;
SELECT COUNT(*) FROM m WHERE ts >= '2026-10-01 02:00:00' AND ts < '2026-10-01 03:00:00';
SELECT COUNT(*) FROM m WHERE ts > '2026-10-01 03:58:00';
SELECT COUNT(*) FROM m WHERE ts < '2026-10-01 00:01:00';
SELECT COUNT(*) FROM m WHERE ts = '2026-10-01 02:30:00';

--echo # Range crossing the flush boundary (minute 150)
SELECT host, metric, COUNT(*), MIN(value), MAX(value)
  FROM m WHERE ts BETWEEN '2026-10-01 02:28:00' AND '2026-10-01 02:33:00'
  GROUP BY host, metric ORDER BY host, metric;

--echo # Fan-out per host (spec §3.3)
SELECT host, AVG(value) FROM m
  WHERE metric = 'cpu' AND ts BETWEEN '2026-10-01 00:00:00' AND '2026-10-01 01:00:00'
  GROUP BY host ORDER BY host;

--echo # Descending order through the index
SELECT ts, host, metric, value FROM m WHERE ts <= '2026-10-01 02:00:00'
  ORDER BY ts DESC, host DESC, metric DESC LIMIT 4;
SELECT ts FROM m ORDER BY ts DESC LIMIT 1;
SELECT ts FROM m ORDER BY ts LIMIT 1;

--echo # Empty and inverted ranges
SELECT COUNT(*) FROM m WHERE ts BETWEEN '2027-01-01' AND '2027-01-02';
SELECT COUNT(*) FROM m WHERE ts BETWEEN '2026-10-01 02:00:00' AND '2026-10-01 01:00:00';

--echo # Filesort with row positions (rnd_pos) over chunks + MemTable
SELECT host, metric, value FROM m WHERE value BETWEEN 239 AND 241 ORDER BY value, host, metric;

DROP TABLE m;
