#
# KNOWN BUG (reported, not fixed): the procedures installed by
# sql/tideflow_install.sql from a client whose character set is latin1 (the
# mysql client default in many setups) cannot reach tables with non-ASCII
# names: the identifier reaches the UDF re-encoded as latin1 and
#   CALL tideflow_apply_retention('ünï')
# fails with "TideFlow: sec. is not an open TideFlow table", although the same
# table is reachable through the UDF or when the install file was loaded with
# --default-character-set=utf8mb4.
#
# The test expects the CORRECT behavior, so it fails until the bug is fixed.
#
--source suite/tideflow/include/have_tideflow.inc
SET NAMES utf8mb4;
CREATE DATABASE sec CHARACTER SET utf8mb4;
USE sec;
--exec $MYSQL sec < $TIDEFLOW_INSTALL_SQL
CREATE TABLE `ünï` (ts DATETIME NOT NULL, v INT, INDEX(ts)) ENGINE=TideFlow;
INSERT INTO `ünï` VALUES ('2026-01-01', 1);
CALL tideflow_apply_retention('ünï');
CALL tideflow_compact('ünï', NULL, NULL);
USE test;
DROP DATABASE sec;
DROP FUNCTION tideflow_compact_impl;
DROP FUNCTION tideflow_retention_impl;
