#
# PARTITION BY on a TideFlow table: creation, reads, pushdown, ordered scans,
# TRUNCATE (partition and table), REMOVE PARTITIONING, RENAME, DROP and a
# restart. Partition-count changes (ADD/COALESCE PARTITION) are NOT here:
# they lose or duplicate rows, see bug_partition_reorg.test.
#
--source include/not_embedded.inc
--source include/have_sequence.inc
--source suite/tideflow/include/have_tideflow.inc
--source include/have_partition.inc
let MYSQLD_DATADIR= `SELECT @@datadir`;

CREATE TABLE pt (ts DATETIME NOT NULL, host VARCHAR(8) NOT NULL COMMENT 'TAG', v INT, INDEX(ts))
  ENGINE=TideFlow CHUNK_INTERVAL='1 HOUR' PARTITION BY HASH(v) PARTITIONS 3;
CREATE TABLE ctl (ts DATETIME NOT NULL, host VARCHAR(8) NOT NULL, v INT, INDEX(ts)) ENGINE=MyISAM;
SHOW CREATE TABLE pt;
--sorted_result
--list_files $MYSQLD_DATADIR/test pt*

INSERT INTO pt SELECT '2026-01-01' + INTERVAL seq MINUTE, CONCAT('h', seq MOD 3), seq FROM seq_0_to_299;
INSERT INTO ctl SELECT * FROM pt;
let $check= SELECT COUNT(*), SUM(v), MIN(ts), MAX(ts), COUNT(DISTINCT host) FROM pt;
eval $check;
SELECT PARTITION_NAME, TABLE_ROWS FROM information_schema.PARTITIONS WHERE TABLE_NAME = 'pt' ORDER BY PARTITION_NAME;
SELECT COUNT(*) FROM pt WHERE host = 'h1';
SELECT ts FROM pt ORDER BY ts DESC LIMIT 3;
SELECT ts FROM pt ORDER BY ts LIMIT 3;
SELECT ts FROM pt WHERE ts BETWEEN '2026-01-01 01:00:00' AND '2026-01-01 01:05:00' ORDER BY ts;
SELECT v FROM pt WHERE v = 42;
SELECT COUNT(*) FROM pt WHERE v IN (1, 2, 3, 4, 5, 6);
EXPLAIN PARTITIONS SELECT * FROM pt WHERE v = 42;
FLUSH TABLES pt;
eval $check;
SELECT (SELECT GROUP_CONCAT(v ORDER BY v) FROM pt) = (SELECT GROUP_CONCAT(v ORDER BY v) FROM ctl) AS same_rows;
--echo # Maintenance on every partition
OPTIMIZE TABLE pt;
CHECK TABLE pt;
ALTER TABLE pt OPTIMIZE PARTITION p0;
ALTER TABLE pt CHECK PARTITION p1, p2;
eval $check;

--echo # ---- TRUNCATE PARTITION removes exactly the rows hashed there ----
SELECT COUNT(*) FROM pt WHERE v MOD 3 = 0;
ALTER TABLE pt TRUNCATE PARTITION p0;
SELECT COUNT(*), SUM(v MOD 3 = 0) FROM pt;

--echo # ---- Changing the partitioning function rewrites the rows ----
ALTER TABLE pt PARTITION BY KEY(v) PARTITIONS 2;
SELECT COUNT(*), SUM(v) FROM pt;
ALTER TABLE pt REMOVE PARTITIONING;
SELECT COUNT(*), SUM(v) FROM pt;
SHOW CREATE TABLE pt;
ALTER TABLE pt PARTITION BY RANGE (TO_DAYS(ts)) (PARTITION a VALUES LESS THAN (TO_DAYS('2026-01-01')),
  PARTITION b VALUES LESS THAN MAXVALUE);
SELECT COUNT(*) FROM pt;
INSERT INTO pt VALUES ('2025-12-31', 'x', 1);
SELECT COUNT(*) FROM pt;
SELECT PARTITION_NAME, TABLE_ROWS FROM information_schema.PARTITIONS WHERE TABLE_NAME = 'pt' ORDER BY PARTITION_ORDINAL_POSITION;
DROP TABLE pt;
--echo # ... RANGE by time on creation, with partition pruning on the time axis
CREATE TABLE pr (ts DATETIME NOT NULL, v INT, INDEX(ts)) ENGINE=TideFlow
  PARTITION BY RANGE (TO_DAYS(ts)) (
    PARTITION p2026_01 VALUES LESS THAN (TO_DAYS('2026-02-01')),
    PARTITION p2026_02 VALUES LESS THAN (TO_DAYS('2026-03-01')),
    PARTITION pmax VALUES LESS THAN MAXVALUE);
INSERT INTO pr SELECT '2026-01-15' + INTERVAL seq DAY, seq FROM seq_0_to_99;
SELECT PARTITION_NAME, TABLE_ROWS FROM information_schema.PARTITIONS WHERE TABLE_NAME = 'pr' ORDER BY PARTITION_ORDINAL_POSITION;
EXPLAIN PARTITIONS SELECT * FROM pr WHERE ts >= '2026-02-05' AND ts < '2026-02-20';
SELECT COUNT(*) FROM pr WHERE ts >= '2026-02-05' AND ts < '2026-02-20';
ALTER TABLE pr TRUNCATE PARTITION p2026_02;
SELECT COUNT(*) FROM pr;
ALTER TABLE pr DROP PARTITION p2026_01;
SELECT COUNT(*), MIN(ts) FROM pr;
--sorted_result
--list_files $MYSQLD_DATADIR/test pr*

--echo # ---- RENAME, restart, DROP ----
RENAME TABLE pr TO pr2;
INSERT INTO pr2 VALUES ('2030-01-01', -1);
--source include/restart_mysqld.inc
SELECT COUNT(*), MAX(ts) FROM pr2;
--sorted_result
--list_files $MYSQLD_DATADIR/test pr*
DROP TABLE pr2, ctl;
--list_files $MYSQLD_DATADIR/test pr*
--list_files $MYSQLD_DATADIR/test pt*
