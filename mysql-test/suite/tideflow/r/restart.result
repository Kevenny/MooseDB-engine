CREATE TABLE r (
ts    DATETIME(6) NOT NULL,
host  VARCHAR(16) NOT NULL COMMENT 'TAG',
v     DOUBLE,
s     VARCHAR(40),
INDEX(ts)
) ENGINE=TideFlow CHUNK_INTERVAL='1 HOUR' RETENTION_PERIOD='FOREVER' COMPRESSION='LZ4' HOT_THRESHOLD='1 DAY';
# 600 rows in 4 chunks + 300 rows only in the WAL
INSERT INTO r SELECT '2026-02-01 00:00:00' + INTERVAL seq * 20 SECOND, CONCAT('h', seq MOD 5), seq / 4, CONCAT('row-', seq)
FROM seq_0_to_599;
FLUSH TABLES r;
INSERT INTO r SELECT '2026-02-01 04:00:00' + INTERVAL seq * 20 SECOND, CONCAT('h', seq MOD 5), seq / 4, CONCAT('row-', 600 + seq)
FROM seq_0_to_299;
SELECT PENDING_ROWS, CHUNKS FROM information_schema.TIDEFLOW_TABLES WHERE TABLE_NAME = 'r';
PENDING_ROWS	CHUNKS
300	4
SELECT COUNT(*), SUM(v), MIN(ts), MAX(ts), COUNT(DISTINCT host), MD5(GROUP_CONCAT(s ORDER BY ts, host)) FROM r;
COUNT(*)	SUM(v)	MIN(ts)	MAX(ts)	COUNT(DISTINCT host)	MD5(GROUP_CONCAT(s ORDER BY ts, host))
900	56137.5	2026-02-01 00:00:00.000000	2026-02-01 05:39:40.000000	5	4c51d1da4687f646a5bf66bd87bc0c3a
SELECT host, COUNT(*) FROM r GROUP BY host ORDER BY host;
host	COUNT(*)
h0	180
h1	180
h2	180
h3	180
h4	180
# restart 1
# restart
SELECT COUNT(*), SUM(v), MIN(ts), MAX(ts), COUNT(DISTINCT host), MD5(GROUP_CONCAT(s ORDER BY ts, host)) FROM r;
COUNT(*)	SUM(v)	MIN(ts)	MAX(ts)	COUNT(DISTINCT host)	MD5(GROUP_CONCAT(s ORDER BY ts, host))
900	56137.5	2026-02-01 00:00:00.000000	2026-02-01 05:39:40.000000	5	4c51d1da4687f646a5bf66bd87bc0c3a
SELECT host, COUNT(*) FROM r GROUP BY host ORDER BY host;
host	COUNT(*)
h0	180
h1	180
h2	180
h3	180
h4	180
SELECT ROW_COUNT, SERIES, CHUNK_INTERVAL, RETENTION, COMPRESSION FROM information_schema.TIDEFLOW_TABLES WHERE TABLE_NAME = 'r';
ROW_COUNT	SERIES	CHUNK_INTERVAL	RETENTION	COMPRESSION
900	5	1 HOUR	FOREVER	LZ4
SHOW CREATE TABLE r;
Table	Create Table
r	CREATE TABLE `r` (
  `ts` datetime(6) NOT NULL,
  `host` varchar(16) NOT NULL COMMENT 'TAG',
  `v` double DEFAULT NULL,
  `s` varchar(40) DEFAULT NULL,
  KEY `ts` (`ts`)
) ENGINE=TideFlow DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci `CHUNK_INTERVAL`='1 HOUR' `RETENTION_PERIOD`='FOREVER' `COMPRESSION`='LZ4' `HOT_THRESHOLD`='1 DAY'
SELECT COUNT(*) FROM r WHERE host = 'h3' AND ts >= '2026-02-01 04:00:00';
COUNT(*)
60
SELECT ts, host FROM r ORDER BY ts DESC LIMIT 2;
ts	host
2026-02-01 05:39:40.000000	h4
2026-02-01 05:39:20.000000	h3
CHECK TABLE r;
Table	Op	Msg_type	Msg_text
test.r	check	status	OK
# Writes after the restart, then another restart without any flush
INSERT INTO r VALUES ('2026-02-02 00:00:00', 'late', 1.5, 'after-1');
INSERT INTO r VALUES ('2026-01-31 23:59:59.999999', 'early', -1.5, 'before-first');
# restart
SELECT COUNT(*), SUM(v), MIN(ts), MAX(ts), COUNT(DISTINCT host), MD5(GROUP_CONCAT(s ORDER BY ts, host)) FROM r;
COUNT(*)	SUM(v)	MIN(ts)	MAX(ts)	COUNT(DISTINCT host)	MD5(GROUP_CONCAT(s ORDER BY ts, host))
902	56137.5	2026-01-31 23:59:59.999999	2026-02-02 00:00:00.000000	7	586b02bb65a48ae062127551613a80de
SELECT host, v, s FROM r WHERE host IN ('late', 'early') ORDER BY ts;
host	v	s
early	-1.5	before-first
late	1.5	after-1
SELECT ts, host FROM r ORDER BY ts LIMIT 2;
ts	host
2026-01-31 23:59:59.999999	early
2026-02-01 00:00:00.000000	h0
# TRUNCATE survives a restart (no rows resurrected from old WAL/chunks)
TRUNCATE TABLE r;
INSERT INTO r VALUES ('2026-03-01', 'only', 1, 'one');
# restart
SELECT COUNT(*), MIN(s) FROM r;
COUNT(*)	MIN(s)
1	one
SELECT CHUNKS FROM information_schema.TIDEFLOW_TABLES WHERE TABLE_NAME = 'r';
CHUNKS
1
# RENAME survives a restart
RENAME TABLE r TO r2;
INSERT INTO r2 VALUES ('2026-03-02', 'only', 2, 'two');
# restart
SELECT * FROM r2 ORDER BY ts;
ts	host	v	s
2026-03-01 00:00:00.000000	only	1	one
2026-03-02 00:00:00.000000	only	2	two
SELECT * FROM r;
ERROR 42S02: Table 'test.r' doesn't exist
# Several restarts in a row with an empty and a never-written table
CREATE TABLE e (ts DATETIME NOT NULL, INDEX(ts)) ENGINE=TideFlow;
# restart
# restart
SELECT COUNT(*) FROM e;
COUNT(*)
0
INSERT INTO e VALUES ('2026-01-01');
# restart
SELECT COUNT(*) FROM e;
COUNT(*)
1
# An INSERT ... SELECT that straddles chunk boundaries followed by restart
INSERT INTO e SELECT '2026-01-01' + INTERVAL seq HOUR FROM seq_1_to_100;
FLUSH TABLES e;
INSERT INTO e SELECT '2026-01-01' + INTERVAL seq HOUR + INTERVAL 30 MINUTE FROM seq_1_to_100;
# restart
SELECT COUNT(*), MIN(ts), MAX(ts) FROM e;
COUNT(*)	MIN(ts)	MAX(ts)
201	2026-01-01 00:00:00	2026-01-05 04:30:00
CHECK TABLE e;
Table	Op	Msg_type	Msg_text
test.e	check	status	OK
DROP TABLE r2, e;
