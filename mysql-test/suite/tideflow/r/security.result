ERROR 42000: DROP command denied to user 'reader'@'localhost' for table `sec`.`victim`
SELECT COUNT(*) FROM sec.sibling;
ERROR 42000: SELECT command denied to user 'reader'@'localhost' for table `sec`.`sibling`
CALL sec.tideflow_compact('sec.sibling', NULL, NULL);
ERROR 42000: SELECT command denied to user 'reader'@'localhost' for table `sec`.`sibling`
# ... but the procedures act with the invoker's rights, which include SELECT
CALL sec.tideflow_compact('sec.victim', NULL, NULL);
SELECT COUNT(*) FROM sec.victim;
COUNT(*)
21
disconnect reader;
# INSERT lands; DELETE/UPDATE need their own privilege
connect  writer,localhost,writer,,;
INSERT INTO sec.victim VALUES ('2026-01-01', 1000);
DELETE FROM sec.victim;
ERROR 42000: DELETE command denied to user 'writer'@'localhost' for table `sec`.`victim`
UPDATE sec.victim SET v = 0;
ERROR 42000: UPDATE command denied to user 'writer'@'localhost' for table `sec`.`victim`
disconnect writer;
connection default;
SELECT COUNT(*), MAX(v) FROM victim;
COUNT(*)	MAX(v)
22	1000
