# ---- Scope: all variables are global-only ----
SET SESSION tideflow_wal_sync_mode = 'write';
ERROR HY000: Variable 'tideflow_wal_sync_mode' is a GLOBAL variable and should be set with SET GLOBAL
SET tideflow_max_open_chunks = 5;
ERROR HY000: Variable 'tideflow_max_open_chunks' is a GLOBAL variable and should be set with SET GLOBAL
SELECT @@SESSION.tideflow_chunk_cache_size;
ERROR HY000: Variable 'tideflow_chunk_cache_size' is a GLOBAL variable
SELECT @@GLOBAL.tideflow_chunk_cache_size = @@tideflow_chunk_cache_size;
@@GLOBAL.tideflow_chunk_cache_size = @@tideflow_chunk_cache_size
1
# ---- tideflow_compaction_threads is read-only ----
SET GLOBAL tideflow_compaction_threads = 4;
ERROR HY000: Variable 'tideflow_compaction_threads' is a read only variable
SELECT @@GLOBAL.tideflow_compaction_threads;
@@GLOBAL.tideflow_compaction_threads
2
# ---- tideflow_wal_sync_mode (ENUM) ----
SET GLOBAL tideflow_wal_sync_mode = 'write';
SELECT @@GLOBAL.tideflow_wal_sync_mode;
@@GLOBAL.tideflow_wal_sync_mode
write
SET GLOBAL tideflow_wal_sync_mode = 'FSYNC';
SELECT @@GLOBAL.tideflow_wal_sync_mode;
@@GLOBAL.tideflow_wal_sync_mode
fsync
SET GLOBAL tideflow_wal_sync_mode = 0;
SELECT @@GLOBAL.tideflow_wal_sync_mode;
@@GLOBAL.tideflow_wal_sync_mode
fsync
SET GLOBAL tideflow_wal_sync_mode = 1;
SELECT @@GLOBAL.tideflow_wal_sync_mode;
@@GLOBAL.tideflow_wal_sync_mode
write
SET GLOBAL tideflow_wal_sync_mode = 'none';
ERROR 42000: Variable 'tideflow_wal_sync_mode' can't be set to the value of 'none'
SET GLOBAL tideflow_wal_sync_mode = 7;
ERROR 42000: Variable 'tideflow_wal_sync_mode' can't be set to the value of '7'
SET GLOBAL tideflow_wal_sync_mode = '';
ERROR 42000: Variable 'tideflow_wal_sync_mode' can't be set to the value of ''
SET GLOBAL tideflow_wal_sync_mode = 1.5;
ERROR 42000: Incorrect argument type to variable 'tideflow_wal_sync_mode'
SET GLOBAL tideflow_wal_sync_mode = DEFAULT;
SELECT @@GLOBAL.tideflow_wal_sync_mode;
@@GLOBAL.tideflow_wal_sync_mode
fsync
# ---- Numeric limits: out-of-range values are clamped with a warning ----
SET GLOBAL tideflow_max_open_chunks = 0;
Warnings:
Warning	1292	Truncated incorrect tideflow_max_open_chunks value: '0'
SELECT @@GLOBAL.tideflow_max_open_chunks;
@@GLOBAL.tideflow_max_open_chunks
1
SET GLOBAL tideflow_max_open_chunks = 100000000;
