CREATE TABLE ctl (ts DATETIME NOT NULL, v INT, INDEX(ts)) ENGINE=MyISAM PARTITION BY HASH(v) PARTITIONS 3;
CREATE TABLE pt (ts DATETIME NOT NULL, v INT, INDEX(ts)) ENGINE=TideFlow PARTITION BY HASH(v) PARTITIONS 3;
INSERT INTO pt SELECT '2026-01-01' + INTERVAL seq MINUTE, seq FROM seq_0_to_29;
INSERT INTO ctl SELECT * FROM pt;
SELECT COUNT(*) FROM pt;
COUNT(*)
30
ALTER TABLE pt ADD PARTITION (PARTITION p3);
ALTER TABLE ctl ADD PARTITION (PARTITION p3);
# rows after ADD PARTITION: must still be 30
SELECT COUNT(*) FROM pt;
COUNT(*)
30
ALTER TABLE pt COALESCE PARTITION 1;
ALTER TABLE ctl COALESCE PARTITION 1;
# rows after COALESCE PARTITION: must still be 30
SELECT COUNT(*) FROM pt;
COUNT(*)
30
SELECT COUNT(*) FROM ctl;
COUNT(*)
30
ALTER TABLE pt REBUILD PARTITION p0;
SELECT COUNT(*) FROM pt;
COUNT(*)
30
DROP TABLE pt, ctl;
