CREATE TABLE t (
ts      DATETIME(6) NOT NULL,
site    INT NOT NULL COMMENT 'TAG',
i8      TINYINT,
u64     BIGINT UNSIGNED,
i64     BIGINT,
f       FLOAT,
d       DOUBLE,
dec1    DECIMAL(20,6),
b       BOOLEAN,
vc      VARCHAR(100) CHARACTER SET utf8mb4,
txt     TEXT,
bin     VARBINARY(16),
dt      DATE,
tm      TIME(3),
e       ENUM('ok','warn','crit'),
yr      YEAR,
js      JSON,
INDEX ts_idx (ts)
) ENGINE=TideFlow;
INSERT INTO t VALUES
