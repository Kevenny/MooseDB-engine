CREATE TABLE r (ts DATETIME NOT NULL, v INT, INDEX(ts))
ENGINE=TideFlow CHUNK_INTERVAL='1 DAY' RETENTION_PERIOD='30 DAYS';
INSERT INTO r VALUES
(NOW() - INTERVAL 400 DAY, 1),
(NOW() - INTERVAL 100 DAY, 2),
(NOW() - INTERVAL 1 DAY, 3),
(NOW(), 4);
FLUSH TABLES r;
# Expired chunks are visible before the sweep
SELECT STATUS, COUNT(*) FROM information_schema.TIDEFLOW_CHUNKS
WHERE TABLE_NAME = 'r' GROUP BY STATUS ORDER BY STATUS;
STATUS	COUNT(*)
EXPIRED	2
HOT	2
SELECT EXPIRED_CHUNKS, RETENTION FROM information_schema.TIDEFLOW_TABLES WHERE TABLE_NAME = 'r';
EXPIRED_CHUNKS	RETENTION
2	30 DAYS
# CALL tideflow_apply_retention
CALL tideflow_apply_retention('test.r');
SELECT v FROM r ORDER BY v;
v
3
4
# Background sweep
INSERT INTO r VALUES (NOW() - INTERVAL 200 DAY, 5);
FLUSH TABLES r;
SELECT v FROM r ORDER BY v;
v
3
4
5
SET @old = @@GLOBAL.tideflow_retention_check_interval;
SET GLOBAL tideflow_retention_check_interval = 1;
# the table must be open for the background threads to see it
SELECT COUNT(*) FROM r;
COUNT(*)
3
SELECT v FROM r ORDER BY v;
v
3
4
SET GLOBAL tideflow_retention_check_interval = @old;
# FOREVER never expires
CREATE TABLE f (ts DATETIME NOT NULL, INDEX(ts)) ENGINE=TideFlow RETENTION_PERIOD='FOREVER';
INSERT INTO f VALUES ('1990-01-01');
OPTIMIZE TABLE f;
Table	Op	Msg_type	Msg_text
test.f	optimize	status	OK
SELECT COUNT(*) FROM f;
COUNT(*)
1
DROP TABLE r, f;
DROP PROCEDURE tideflow_compact;
DROP PROCEDURE tideflow_apply_retention;
DROP FUNCTION tideflow_compact_impl;
DROP FUNCTION tideflow_retention_impl;
