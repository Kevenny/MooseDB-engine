CREATE TABLE c (ts DATETIME(6) NOT NULL, w INT, INDEX(ts)) ENGINE=TideFlow MEMTABLE_SIZE=65536;
INSERT INTO c SELECT '2026-01-01' + INTERVAL seq SECOND, 0 FROM seq_1_to_200;
# A slow reader holds the table...
connect  reader, localhost, root,,;
SELECT COUNT(*), SLEEP(3) FROM c WHERE w = 0 AND SLEEP(0.01) = 0;
# ... while two writers insert (and flush, the MemTable is tiny)
connect  w1, localhost, root,,;
INSERT INTO c SELECT '2026-02-01' + INTERVAL seq SECOND, 1 FROM seq_1_to_3000;
connect  w2, localhost, root,,;
INSERT INTO c SELECT '2026-03-01' + INTERVAL seq SECOND, 2 FROM seq_1_to_3000;
connection w1;
# The reader is still running: the writers were not blocked
connection default;
SELECT COUNT(*) FROM information_schema.PROCESSLIST WHERE INFO LIKE 'SELECT COUNT(*), SLEEP(3)%';
COUNT(*)
1
SELECT w, COUNT(*) FROM c GROUP BY w ORDER BY w;
w	COUNT(*)
0	200
1	3000
2	3000
# The reader saw its snapshot
connection reader;
COUNT(*)	SLEEP(3)
200	#
disconnect reader;
disconnect w1;
disconnect w2;
connection default;
# Filesort (rnd_pos) while another session flushes and compacts
connect  w3, localhost, root,,;
INSERT INTO c SELECT '2026-04-01' + INTERVAL seq SECOND, 3 FROM seq_1_to_5000;
connection default;
SELECT w, v FROM (SELECT w, ts AS v FROM c WHERE w IN (1, 2) ORDER BY w DESC, ts DESC LIMIT 2) x ORDER BY w;
w	v
2	2026-03-01 00:50:00.000000
2	2026-03-01 00:49:59.000000
connection w3;
disconnect w3;
connection default;
SELECT COUNT(*) FROM c;
COUNT(*)
11200
# LOCK TABLES: every single-row INSERT is durable right away
LOCK TABLES c WRITE;
INSERT INTO c VALUES ('2026-05-01', 5);
INSERT INTO c VALUES ('2026-05-02', 5);
# Kill the server
# restart
SELECT COUNT(*) FROM c WHERE w = 5;
COUNT(*)
2
DROP TABLE c;
