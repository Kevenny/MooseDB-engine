#
# The procedures installed by sql/moosedb_install.sql must reach tables with
# non-ASCII names whatever character set the installing client used (latin1 is
# the mysql client default in many setups), and whatever the character set of
# the calling session.
#
--source suite/moosedb/include/have_moosedb.inc
SET NAMES utf8mb4;
CREATE DATABASE sec CHARACTER SET latin1;
USE sec;
--echo # Install from a latin1 client, in a latin1 database
--exec $MYSQL --default-character-set=latin1 sec < $MOOSEDB_INSTALL_SQL
CREATE TABLE `ünï` (ts DATETIME NOT NULL, v INT, INDEX(ts)) ENGINE=MooseDB;
INSERT INTO `ünï` VALUES ('2026-01-01', 1);
CALL moosedb_apply_retention('ünï');
CALL moosedb_compact('ünï', NULL, NULL);
CALL moosedb_compact('sec.ünï', '2026-01-01', '2026-01-02');

--echo # Names beyond latin1 in a utf8mb4 database
CREATE DATABASE `sé€` CHARACTER SET utf8mb4;
CREATE TABLE `sé€`.`日本` (ts DATETIME NOT NULL, v INT, INDEX(ts)) ENGINE=MooseDB;
INSERT INTO `sé€`.`日本` VALUES ('2026-01-01', 1);
CALL moosedb_apply_retention('sé€.日本');
CALL moosedb_compact('sé€.日本', NULL, NULL);

--echo # Called from a latin1 session
SET NAMES latin1;
CALL moosedb_apply_retention(_utf8mb4'ünï');
CALL moosedb_compact(_utf8mb4'sé€.日本', NULL, NULL);
SET NAMES utf8mb4;

--echo # Quoting is not affected by sql_mode, and names with quotes are inert
SET sql_mode= 'NO_BACKSLASH_ESCAPES,ANSI_QUOTES';
--error ER_NO_SUCH_TABLE
CALL moosedb_apply_retention('a\');
--error ER_NO_SUCH_TABLE
CALL moosedb_apply_retention('a`b');
SET sql_mode= DEFAULT;
--echo # A failed call leaves nothing prepared behind
--error ER_NO_SUCH_TABLE
CALL moosedb_apply_retention('no_such_table');
--error ER_UNKNOWN_STMT_HANDLER
EXECUTE __moosedb_retention_stmt;

USE test;
DROP DATABASE sec;
DROP DATABASE `sé€`;
DROP FUNCTION moosedb_compact_impl;
DROP FUNCTION moosedb_retention_impl;
