#
# INSERTs run concurrently with SELECTs and with each other; LOCK TABLES
# inserts are durable statement by statement.
#
--source include/not_embedded.inc
--source include/have_sequence.inc
--source suite/moosedb/include/have_moosedb.inc

CREATE TABLE c (ts DATETIME(6) NOT NULL, w INT, INDEX(ts)) ENGINE=MooseDB MEMTABLE_SIZE=1048576;
INSERT INTO c SELECT '2026-01-01' + INTERVAL seq SECOND, 0 FROM seq_1_to_200;

--echo # A slow reader holds the table...
connect (reader, localhost, root,,);
send SELECT COUNT(*), SLEEP(3) FROM c WHERE w = 0 AND SLEEP(0.01) = 0;

--echo # ... while two writers insert (60000 rows against a 1 MiB MemTable: several flushes)
connect (w1, localhost, root,,);
send INSERT INTO c SELECT '2026-02-01' + INTERVAL seq SECOND, 1 FROM seq_1_to_30000;
connect (w2, localhost, root,,);
INSERT INTO c SELECT '2026-03-01' + INTERVAL seq SECOND, 2 FROM seq_1_to_30000;
connection w1;
reap;

--echo # The reader is still running: the writers were not blocked
connection default;
--echo # Proof that flushes ran while the reader held the table (no FLUSH issued)
SELECT CHUNKS >= 2 AS flushed, PENDING_ROWS < 60200 AS not_all_pending FROM information_schema.MOOSEDB_TABLES WHERE TABLE_NAME = 'c';
SELECT COUNT(*) FROM information_schema.PROCESSLIST WHERE INFO LIKE 'SELECT COUNT(*), SLEEP(3)%';
SELECT w, COUNT(*) FROM c GROUP BY w ORDER BY w;

--echo # The reader saw its snapshot
connection reader;
--replace_column 2 #
reap;
disconnect reader;
disconnect w1;
disconnect w2;
connection default;

--echo # Filesort (rnd_pos) while another session flushes (and the background compactor may run)
connect (w3, localhost, root,,);
send INSERT INTO c SELECT '2026-04-01' + INTERVAL seq SECOND, 3 FROM seq_1_to_50000;
connection default;
SELECT w, v FROM (SELECT w, ts AS v FROM c WHERE w IN (1, 2) ORDER BY w DESC, ts DESC LIMIT 2) x ORDER BY w, v DESC;
connection w3;
reap;
disconnect w3;
connection default;
SELECT COUNT(*) FROM c;
--echo # Flushed chunks (possibly merged by the background compactor) are still there
SELECT CHUNKS >= 2 AS chunked FROM information_schema.MOOSEDB_TABLES WHERE TABLE_NAME = 'c';

--echo # LOCK TABLES: every single-row INSERT is durable right away
LOCK TABLES c WRITE;
INSERT INTO c VALUES ('2026-05-01', 5);
INSERT INTO c VALUES ('2026-05-02', 5);
--source include/kill_mysqld.inc
--source include/start_mysqld.inc
SELECT COUNT(*) FROM c WHERE w = 5;

DROP TABLE c;
