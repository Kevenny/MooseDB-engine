#
# Encryption at rest (AES-256-CTR, keys from file_key_management).
#
--source include/not_embedded.inc
--source include/have_sequence.inc
--source suite/moosedb/include/have_moosedb.inc

CREATE TABLE s (ts DATETIME(6) NOT NULL, host VARCHAR(32) NOT NULL COMMENT 'TAG', note VARCHAR(64), INDEX(ts))
  ENGINE=MooseDB ENCRYPTION='YES' ENCRYPTION_KEY_ID=2;
SHOW CREATE TABLE s;
INSERT INTO s SELECT '2026-01-01' + INTERVAL seq SECOND, 'SECRET-HOST-NAME', CONCAT('CONFIDENTIAL-', seq)
  FROM seq_1_to_500;

--echo # Control: an unencrypted table does show plaintext
let MYSQLD_DATADIR= `SELECT @@datadir`;
CREATE TABLE plain (ts DATETIME NOT NULL, note VARCHAR(32), INDEX(ts)) ENGINE=MooseDB;
INSERT INTO plain VALUES ('2026-01-01', 'CONFIDENTIAL-0');
FLUSH TABLES plain;
--let SEARCH_DIR= test/plain
--source suite/moosedb/include/grep_table_files.inc
DROP TABLE plain;

--echo # Neither the WAL nor sealed chunks contain plaintext
--let SEARCH_DIR= test/s
--source suite/moosedb/include/grep_table_files.inc
FLUSH TABLES s;
--source suite/moosedb/include/grep_table_files.inc

SELECT COUNT(*), MIN(note), MAX(note), COUNT(DISTINCT host) FROM s;
SELECT ENCRYPTED, COMPRESSION FROM information_schema.MOOSEDB_TABLES WHERE TABLE_NAME = 's';
SELECT DISTINCT ENCRYPTED FROM information_schema.MOOSEDB_CHUNKS WHERE TABLE_NAME = 's';
CHECK TABLE s;

--echo # Data survives a restart (keys fetched again from the key plugin)
--source include/restart_mysqld.inc
SELECT COUNT(*), MAX(note) FROM s WHERE host = 'SECRET-HOST-NAME';
OPTIMIZE TABLE s;
SELECT COUNT(*) FROM s;
--source suite/moosedb/include/grep_table_files.inc

--echo # Keys must exist and be 256 bits
--error ER_ILLEGAL_HA_CREATE_OPTION
CREATE TABLE bad (ts DATETIME NOT NULL, INDEX(ts)) ENGINE=MooseDB ENCRYPTION='YES' ENCRYPTION_KEY_ID=99;
--error ER_ILLEGAL_HA_CREATE_OPTION
CREATE TABLE bad (ts DATETIME NOT NULL, INDEX(ts)) ENGINE=MooseDB ENCRYPTION='YES' ENCRYPTION_KEY_ID=3;

--echo # A wrong key is a decryption failure (HA_ERR_DECRYPTION_FAILED), not corruption
call mtr.add_suppression("MooseDB");
INSERT INTO s VALUES ('2026-01-02', 'SECRET-HOST-NAME', 'CONFIDENTIAL-after');
--let $restart_parameters= --file-key-management-filename=$MYSQL_TEST_DIR/suite/moosedb/std_data/keys_wrong.txt
--source include/restart_mysqld.inc
--error ER_GET_ERRMSG
SELECT COUNT(*) FROM s;
SHOW WARNINGS;
--error ER_GET_ERRMSG
INSERT INTO s VALUES ('2026-01-03', 'SECRET-HOST-NAME', 'CONFIDENTIAL-wrong-key');
--echo # The files were not touched: with the right key again, all data is back
--let $restart_parameters=
--source include/restart_mysqld.inc
SELECT COUNT(*), MAX(note) FROM s;
CHECK TABLE s;
--let SEARCH_DIR= test/s
--source suite/moosedb/include/grep_table_files.inc

DROP TABLE s;
