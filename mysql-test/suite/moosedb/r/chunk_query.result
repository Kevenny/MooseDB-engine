CREATE TABLE m (
ts     DATETIME(6) NOT NULL,
host   VARCHAR(16) NOT NULL COMMENT 'TAG',
metric VARCHAR(16) NOT NULL COMMENT 'TAG',
value  DOUBLE,
INDEX ts_idx (ts)
) ENGINE=MooseDB CHUNK_INTERVAL='1 HOUR';
# 3 hosts x 2 metrics x 240 minutes, written in two batches with a flush
# in between so data spans several chunks and the MemTable.
SELECT COUNT(*), MIN(ts), MAX(ts) FROM m;
COUNT(*)	MIN(ts)	MAX(ts)
1440	2026-10-01 00:00:00.000000	2026-10-01 03:59:00.000000
# Range on the timestamp index
EXPLAIN SELECT * FROM m WHERE ts BETWEEN '2026-10-01 01:00:00' AND '2026-10-01 01:04:00';
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	m	range	ts_idx	ts_idx	8	NULL	#	Using where
SELECT * FROM m WHERE ts BETWEEN '2026-10-01 01:00:00' AND '2026-10-01 01:01:00' ORDER BY ts, host, metric;
ts	host	metric	value
2026-10-01 01:00:00.000000	srv01	cpu	60
2026-10-01 01:00:00.000000	srv01	mem	1060
2026-10-01 01:00:00.000000	srv02	cpu	120
2026-10-01 01:00:00.000000	srv02	mem	2060
2026-10-01 01:00:00.000000	srv03	cpu	180
2026-10-01 01:00:00.000000	srv03	mem	3060
2026-10-01 01:01:00.000000	srv01	cpu	61
2026-10-01 01:01:00.000000	srv01	mem	1061
2026-10-01 01:01:00.000000	srv02	cpu	122
2026-10-01 01:01:00.000000	srv02	mem	2061
2026-10-01 01:01:00.000000	srv03	cpu	183
2026-10-01 01:01:00.000000	srv03	mem	3061
SELECT COUNT(*) FROM m WHERE ts >= '2026-10-01 02:00:00' AND ts < '2026-10-01 03:00:00';
COUNT(*)
360
SELECT COUNT(*) FROM m WHERE ts > '2026-10-01 03:58:00';
COUNT(*)
6
SELECT COUNT(*) FROM m WHERE ts < '2026-10-01 00:01:00';
COUNT(*)
6
SELECT COUNT(*) FROM m WHERE ts = '2026-10-01 02:30:00';
COUNT(*)
6
# Range crossing the flush boundary (minute 150)
SELECT host, metric, COUNT(*), MIN(value), MAX(value)
FROM m WHERE ts BETWEEN '2026-10-01 02:28:00' AND '2026-10-01 02:33:00'
  GROUP BY host, metric ORDER BY host, metric;
host	metric	COUNT(*)	MIN(value)	MAX(value)
srv01	cpu	6	148	153
srv01	mem	6	1148	1153
srv02	cpu	6	296	306
srv02	mem	6	2148	2153
srv03	cpu	6	444	459
srv03	mem	6	3148	3153
# Fan-out per host (spec §3.3)
SELECT host, AVG(value) FROM m
WHERE metric = 'cpu' AND ts BETWEEN '2026-10-01 00:00:00' AND '2026-10-01 01:00:00'
  GROUP BY host ORDER BY host;
host	AVG(value)
srv01	30
srv02	60
srv03	90
# Descending order through the index
SELECT ts, host, metric, value FROM m WHERE ts <= '2026-10-01 02:00:00'
  ORDER BY ts DESC, host DESC, metric DESC LIMIT 4;
ts	host	metric	value
2026-10-01 02:00:00.000000	srv03	mem	3120
2026-10-01 02:00:00.000000	srv03	cpu	360
2026-10-01 02:00:00.000000	srv02	mem	2120
2026-10-01 02:00:00.000000	srv02	cpu	240
SELECT ts FROM m ORDER BY ts DESC LIMIT 1;
ts
2026-10-01 03:59:00.000000
SELECT ts FROM m ORDER BY ts LIMIT 1;
ts
2026-10-01 00:00:00.000000
# Empty and inverted ranges
SELECT COUNT(*) FROM m WHERE ts BETWEEN '2027-01-01' AND '2027-01-02';
COUNT(*)
0
SELECT COUNT(*) FROM m WHERE ts BETWEEN '2026-10-01 02:00:00' AND '2026-10-01 01:00:00';
COUNT(*)
0
# Filesort with row positions (rnd_pos) over chunks + MemTable
SELECT host, metric, value FROM m WHERE value BETWEEN 239 AND 241 ORDER BY value, host, metric;
host	metric	value
srv01	cpu	239
srv02	cpu	240
srv03	cpu	240
DROP TABLE m;
