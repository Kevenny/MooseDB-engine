connect  wr, localhost, root,,;
connect  wr2, localhost, root,,;
# Large INSERT...SELECT: concurrent readers see 0 or N rows, never in between
CREATE TABLE a (ts DATETIME(6) NOT NULL, v INT, INDEX(ts)) ENGINE=MooseDB;
connection wr;
INSERT INTO a SELECT '2026-01-01' + INTERVAL seq SECOND, seq FROM seq_1_to_2000000;
connection default;
partial_seen = 0
observed_during_insert = 1
connection wr;
connection default;
SELECT COUNT(*) FROM a;
COUNT(*)
2000000
# Same with a tiny MemTable (the batch spills to disk)
CREATE TABLE b (ts DATETIME(6) NOT NULL, v INT, INDEX(ts)) ENGINE=MooseDB MEMTABLE_SIZE=4096;
connection wr;
INSERT INTO b SELECT '2026-01-01' + INTERVAL seq SECOND, seq FROM seq_1_to_200000;
connection default;
partial_seen = 0
observed_during_insert = 1
connection wr;
connection default;
SELECT COUNT(*), SUM(v) FROM b;
COUNT(*)	SUM(v)
200000	20000100000
# Two concurrent writers into the same table
CREATE TABLE c2 (ts DATETIME(6) NOT NULL, v INT, INDEX(ts)) ENGINE=MooseDB MEMTABLE_SIZE=4096;
connection wr;
INSERT INTO c2 SELECT '2026-01-01' + INTERVAL seq SECOND, 1 FROM seq_1_to_150000;
connection wr2;
INSERT INTO c2 SELECT '2026-02-01' + INTERVAL seq SECOND, 2 FROM seq_1_to_150000;
connection default;
partial_seen = 0
observed_during_insert = 1
connection wr;
connection wr2;
connection default;
SELECT v, COUNT(*) FROM c2 GROUP BY v ORDER BY v;
v	COUNT(*)
1	150000
2	150000
# Multi-row INSERT is one statement too
INSERT INTO c2 VALUES ('2027-01-01', 3), ('2027-01-02', 3), ('2027-01-03', 3);
SELECT COUNT(*) FROM c2 WHERE v = 3;
COUNT(*)
3
# Table with a BEFORE INSERT trigger (prelocked: no bulk insert calls)
CREATE TABLE tt (ts DATETIME(6) NOT NULL, v INT, INDEX(ts)) ENGINE=MooseDB;
CREATE TRIGGER tt_bi BEFORE INSERT ON tt FOR EACH ROW SET NEW.v= NEW.v + 1;
connection wr;
INSERT INTO tt SELECT '2026-01-01' + INTERVAL seq SECOND, seq FROM seq_1_to_200000;
connection default;
partial_seen = 0
observed_during_insert = 1
connection wr;
connection default;
SELECT COUNT(*), SUM(v) FROM tt;
COUNT(*)	SUM(v)
200000	20000300000
# Inside a stored procedure
CREATE TABLE tp (ts DATETIME(6) NOT NULL, v INT, INDEX(ts)) ENGINE=MooseDB;
CREATE PROCEDURE p()
BEGIN
INSERT INTO tp SELECT '2026-01-01' + INTERVAL seq SECOND, seq FROM seq_1_to_200000;
END|
connection wr;
CALL p();
connection default;
partial_seen = 0
observed_during_insert = 1
connection wr;
connection default;
SELECT COUNT(*), SUM(v) FROM tp;
COUNT(*)	SUM(v)
200000	20000100000
disconnect wr;
disconnect wr2;
DROP PROCEDURE p;
DROP TABLE a, b, c2, tt, tp;
