SELECT PLUGIN_NAME, PLUGIN_STATUS, PLUGIN_TYPE FROM information_schema.PLUGINS
WHERE PLUGIN_NAME LIKE 'MOOSEDB%' OR PLUGIN_NAME = 'MooseDB' ORDER BY PLUGIN_NAME;
PLUGIN_NAME	PLUGIN_STATUS	PLUGIN_TYPE
MooseDB	ACTIVE	STORAGE ENGINE
MOOSEDB_CHUNKS	ACTIVE	INFORMATION SCHEMA
MOOSEDB_TABLES	ACTIVE	INFORMATION SCHEMA
SHOW COLUMNS FROM information_schema.MOOSEDB_TABLES;
Field	Type	Null	Key	Default	Extra
TABLE_SCHEMA	varchar(64)	NO		NULL	
TABLE_NAME	varchar(64)	NO		NULL	
ROW_COUNT	bigint(21) unsigned	NO		NULL	
PENDING_ROWS	bigint(21) unsigned	NO		NULL	
SERIES	bigint(21) unsigned	NO		NULL	
DATA_BYTES	bigint(21) unsigned	NO		NULL	
COMPRESSED_BYTES	bigint(21) unsigned	NO		NULL	
CHUNKS	int(11) unsigned	NO		NULL	
HOT_CHUNKS	int(11) unsigned	NO		NULL	
WARM_CHUNKS	int(11) unsigned	NO		NULL	
COLD_CHUNKS	int(11) unsigned	NO		NULL	
COMPACTING_CHUNKS	int(11) unsigned	NO		NULL	
EXPIRED_CHUNKS	int(11) unsigned	NO		NULL	
RETENTION	varchar(32)	NO		NULL	
CHUNK_INTERVAL	varchar(32)	NO		NULL	
COMPRESSION	varchar(8)	NO		NULL	
ENCRYPTED	varchar(3)	NO		NULL	
IS_OPEN	varchar(3)	NO		NULL	
SHOW COLUMNS FROM information_schema.MOOSEDB_CHUNKS;
Field	Type	Null	Key	Default	Extra
TABLE_SCHEMA	varchar(64)	NO		NULL	
TABLE_NAME	varchar(64)	NO		NULL	
CHUNK_ID	bigint(21) unsigned	NO		NULL	
TS_MIN	datetime(6)	NO		NULL	
TS_MAX	datetime(6)	NO		NULL	
ROWS	bigint(21) unsigned	NO		NULL	
SERIES	int(11) unsigned	NO		NULL	
DATA_MB	double	NO		NULL	
COMPRESSED_MB	double	NO		NULL	
RATIO	double	NO		NULL	
STATUS	varchar(16)	NO		NULL	
COMPRESSION	varchar(8)	NO		NULL	
ENCRYPTED	varchar(3)	NO		NULL	
SEALED_AT	datetime(6)	NO		NULL	
CHUNK_FILE	varchar(255)	NO		NULL	
CREATE DATABASE `tf-db`;
CREATE TABLE `tf-db`.`m-1` (ts DATETIME(6) NOT NULL, host VARCHAR(8) NOT NULL COMMENT 'TAG', v DOUBLE, INDEX(ts))
ENGINE=MooseDB CHUNK_INTERVAL='1 HOUR' RETENTION_PERIOD='3650 DAYS';
INSERT INTO `tf-db`.`m-1` SELECT '2026-01-01' + INTERVAL seq MINUTE, CONCAT('h', seq MOD 4), seq FROM seq_0_to_179;
FLUSH TABLES `tf-db`.`m-1`;
INSERT INTO `tf-db`.`m-1` VALUES ('2026-01-01 05:00:00', 'h9', 1);
# Names are decoded from the file system encoding; unsealed rows are PENDING
SELECT TABLE_SCHEMA, TABLE_NAME, ROW_COUNT, PENDING_ROWS, SERIES, CHUNKS, RETENTION, CHUNK_INTERVAL,
COMPRESSION, ENCRYPTED
FROM information_schema.MOOSEDB_TABLES WHERE TABLE_SCHEMA = 'tf-db';
TABLE_SCHEMA	TABLE_NAME	ROW_COUNT	PENDING_ROWS	SERIES	CHUNKS	RETENTION	CHUNK_INTERVAL	COMPRESSION	ENCRYPTED
tf-db	m-1	181	1	5	3	3650 DAYS	1 HOUR	ZSTD	NO
SELECT CHUNK_ID, TS_MIN, TS_MAX, `ROWS`, SERIES, STATUS, COMPRESSION, ENCRYPTED, CHUNK_FILE,
DATA_MB > COMPRESSED_MB AS compressed, SEALED_AT > NOW() - INTERVAL 1 HOUR AS recent
FROM information_schema.MOOSEDB_CHUNKS WHERE TABLE_SCHEMA = 'tf-db' ORDER BY CHUNK_ID;
CHUNK_ID	TS_MIN	TS_MAX	ROWS	SERIES	STATUS	COMPRESSION	ENCRYPTED	CHUNK_FILE	compressed	recent
1	2026-01-01 00:00:00.000000	2026-01-01 00:59:00.000000	60	4	COLD	ZSTD	NO	chunk_20260101T000000_20260101T010000_000001.tfl	1	1
2	2026-01-01 01:00:00.000000	2026-01-01 01:59:00.000000	60	4	COLD	ZSTD	NO	chunk_20260101T010000_20260101T020000_000002.tfl	1	1
3	2026-01-01 02:00:00.000000	2026-01-01 02:59:00.000000	60	4	COLD	ZSTD	NO	chunk_20260101T020000_20260101T030000_000003.tfl	1	1
# Closed tables are read from disk without opening them
FLUSH TABLES;
SELECT ROW_COUNT, PENDING_ROWS, CHUNKS FROM information_schema.MOOSEDB_TABLES WHERE TABLE_SCHEMA = 'tf-db';
ROW_COUNT	PENDING_ROWS	CHUNKS
181	0	4
# Storage internals require the PROCESS privilege
CREATE USER tf_user;
GRANT SELECT ON `tf-db`.* TO tf_user;
connect  u, localhost, tf_user,,;
SELECT COUNT(*) FROM information_schema.MOOSEDB_TABLES;
COUNT(*)
0
SELECT COUNT(*) FROM information_schema.MOOSEDB_CHUNKS;
COUNT(*)
0
connection default;
disconnect u;
DROP USER tf_user;
DROP DATABASE `tf-db`;
SELECT COUNT(*) FROM information_schema.MOOSEDB_TABLES WHERE TABLE_SCHEMA = 'tf-db';
COUNT(*)
0
