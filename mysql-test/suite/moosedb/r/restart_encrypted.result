CREATE TABLE s (ts DATETIME(6) NOT NULL, host VARCHAR(32) NOT NULL COMMENT 'TAG', note VARCHAR(64), INDEX(ts))
ENGINE=MooseDB CHUNK_INTERVAL='1 HOUR' ENCRYPTION='YES' ENCRYPTION_KEY_ID=1;
CREATE TABLE k2 (ts DATETIME NOT NULL, note VARCHAR(64), INDEX(ts))
ENGINE=MooseDB ENCRYPTION='YES' ENCRYPTION_KEY_ID=2;
CREATE TABLE plain (ts DATETIME NOT NULL, note VARCHAR(64), INDEX(ts)) ENGINE=MooseDB;
# 300 rows sealed (4 chunks), 100 rows only in the encrypted WAL
INSERT INTO s SELECT '2026-02-01 00:00:00' + INTERVAL seq * 40 SECOND, 'SECRET-HOST', CONCAT('CONFIDENTIAL-', seq)
FROM seq_0_to_299;
FLUSH TABLES s;
INSERT INTO s SELECT '2026-02-01 04:00:00' + INTERVAL seq SECOND, 'SECRET-HOST', CONCAT('CONFIDENTIAL-', 300 + seq)
FROM seq_0_to_99;
INSERT INTO k2 VALUES ('2026-01-01', 'CONFIDENTIAL-k2');
INSERT INTO plain VALUES ('2026-01-01', 'CONFIDENTIAL-plain');
SELECT COUNT(*), MIN(note), MAX(note), COUNT(DISTINCT host) FROM s;
COUNT(*)	MIN(note)	MAX(note)	COUNT(DISTINCT host)
400	CONFIDENTIAL-0	CONFIDENTIAL-99	1
plaintext found in 0 file(s)
# Clean restart
# restart
SELECT COUNT(*), MIN(note), MAX(note), COUNT(DISTINCT host) FROM s;
COUNT(*)	MIN(note)	MAX(note)	COUNT(DISTINCT host)
400	CONFIDENTIAL-0	CONFIDENTIAL-99	1
SELECT note FROM s WHERE host = 'SECRET-HOST' ORDER BY ts DESC LIMIT 2;
note
CONFIDENTIAL-399
CONFIDENTIAL-398
SELECT note FROM k2;
note
CONFIDENTIAL-k2
CHECK TABLE s;
Table	Op	Msg_type	Msg_text
test.s	check	status	OK
CHECK TABLE k2;
Table	Op	Msg_type	Msg_text
test.k2	check	status	OK
SELECT TABLE_NAME, ENCRYPTED FROM information_schema.MOOSEDB_TABLES WHERE TABLE_SCHEMA = 'test' ORDER BY TABLE_NAME;
TABLE_NAME	ENCRYPTED
k2	YES
plain	NO
s	YES
# kill -9 with rows only in the encrypted WAL
INSERT INTO s VALUES ('2026-02-02 00:00:00', 'SECRET-HOST', 'CONFIDENTIAL-after-restart');
INSERT INTO k2 VALUES ('2026-01-02', 'CONFIDENTIAL-k2-b');
# Kill the server
# restart
SELECT COUNT(*), MIN(note), MAX(note), COUNT(DISTINCT host) FROM s;
COUNT(*)	MIN(note)	MAX(note)	COUNT(DISTINCT host)
401	CONFIDENTIAL-0	CONFIDENTIAL-after-restart	1
SELECT note FROM s ORDER BY ts DESC LIMIT 1;
note
CONFIDENTIAL-after-restart
SELECT COUNT(*) FROM k2;
COUNT(*)
2
CHECK TABLE s;
Table	Op	Msg_type	Msg_text
test.s	check	status	OK
# Compaction of encrypted chunks, then restart again
OPTIMIZE TABLE s;
Table	Op	Msg_type	Msg_text
test.s	optimize	status	OK
# restart
SELECT COUNT(*), MIN(note), MAX(note), COUNT(DISTINCT host) FROM s;
COUNT(*)	MIN(note)	MAX(note)	COUNT(DISTINCT host)
401	CONFIDENTIAL-0	CONFIDENTIAL-after-restart	1
plaintext found in 0 file(s)
plaintext found in 0 file(s)
# Control: the unencrypted table does leak
FLUSH TABLES plain;
plaintext found in 1 file(s)
# TRUNCATE leaves no plaintext and the table is writable afterwards
TRUNCATE TABLE s;
INSERT INTO s VALUES ('2026-05-01', 'SECRET-HOST', 'CONFIDENTIAL-new');
# restart
SELECT COUNT(*), MIN(note) FROM s;
COUNT(*)	MIN(note)
1	CONFIDENTIAL-new
plaintext found in 0 file(s)
DROP TABLE s, k2, plain;
