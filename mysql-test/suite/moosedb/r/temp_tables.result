CREATE TEMPORARY TABLE tt (ts DATETIME(3) NOT NULL, host VARCHAR(8) NOT NULL COMMENT 'TAG', v INT, INDEX(ts))
ENGINE=MooseDB CHUNK_INTERVAL='1 HOUR';
SHOW CREATE TABLE tt;
Table	Create Table
tt	CREATE TEMPORARY TABLE `tt` (
  `ts` datetime(3) NOT NULL,
  `host` varchar(8) NOT NULL COMMENT 'TAG',
  `v` int(11) DEFAULT NULL,
  KEY `ts` (`ts`)
) ENGINE=MooseDB DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci `CHUNK_INTERVAL`='1 HOUR'
INSERT INTO tt SELECT '2026-01-01' + INTERVAL seq * 10 MINUTE, CONCAT('h', seq MOD 3), seq FROM seq_0_to_29;
SELECT COUNT(*), SUM(v), MIN(ts), MAX(ts) FROM tt;
COUNT(*)	SUM(v)	MIN(ts)	MAX(ts)
30	435	2026-01-01 00:00:00.000	2026-01-01 04:50:00.000
SELECT ts, host, v FROM tt ORDER BY ts DESC LIMIT 3;
ts	host	v
2026-01-01 04:50:00.000	h2	29
2026-01-01 04:40:00.000	h1	28
2026-01-01 04:30:00.000	h0	27
SELECT host, COUNT(*) FROM tt WHERE host = 'h2' GROUP BY host;
host	COUNT(*)
h2	10
SELECT COUNT(*) FROM tt WHERE ts BETWEEN '2026-01-01 01:00:00' AND '2026-01-01 02:00:00';
COUNT(*)
7
# Not visible in INFORMATION_SCHEMA, nor from another session
SELECT COUNT(*) FROM information_schema.MOOSEDB_TABLES WHERE TABLE_NAME = 'tt';
COUNT(*)
0
connect  con2,localhost,root,,test;
SELECT COUNT(*) FROM tt;
ERROR 42S02: Table 'test.tt' doesn't exist
# The same name in two sessions holds independent data
CREATE TEMPORARY TABLE tt (ts DATETIME NOT NULL, other INT, INDEX(ts)) ENGINE=MooseDB;
INSERT INTO tt VALUES ('2030-01-01', 1), ('2030-01-02', 2);
SELECT * FROM tt ORDER BY ts;
ts	other
2030-01-01 00:00:00	1
2030-01-02 00:00:00	2
connection default;
SELECT COUNT(*), SUM(v) FROM tt;
COUNT(*)	SUM(v)
30	435
connection con2;
FLUSH TABLES;
SELECT COUNT(*) FROM tt;
COUNT(*)
2
DROP TEMPORARY TABLE tt;
DROP TEMPORARY TABLE tt;
ERROR 42S02: Unknown table 'test.tt'
SELECT COUNT(*) FROM tt;
ERROR 42S02: Table 'test.tt' doesn't exist
disconnect con2;
connection default;
SELECT COUNT(*), SUM(v) FROM tt;
COUNT(*)	SUM(v)
30	435
# A temporary table shadows a base table of the same name
CREATE TABLE shadow (ts DATETIME NOT NULL, v INT, INDEX(ts)) ENGINE=MooseDB;
INSERT INTO shadow VALUES ('2026-05-05', 1);
CREATE TEMPORARY TABLE shadow (ts DATETIME NOT NULL, v INT, INDEX(ts)) ENGINE=MooseDB;
INSERT INTO shadow VALUES ('2026-06-06', 2), ('2026-06-07', 3);
SELECT COUNT(*) FROM shadow;
COUNT(*)
2
DROP TEMPORARY TABLE shadow;
SELECT COUNT(*) FROM shadow;
COUNT(*)
1
DROP TABLE shadow;
# TRUNCATE, ALTER and RENAME of a temporary table
TRUNCATE TABLE tt;
SELECT COUNT(*) FROM tt;
COUNT(*)
0
INSERT INTO tt VALUES ('2026-02-02', 'a', 1), ('2026-02-03', 'b', 2);
ALTER TABLE tt ADD COLUMN w INT DEFAULT 9;
SELECT * FROM tt ORDER BY ts;
ts	host	v	w
2026-02-02 00:00:00.000	a	1	9
2026-02-03 00:00:00.000	b	2	9
ALTER TABLE tt RENAME TO tt2;
SELECT COUNT(*), SUM(w) FROM tt2;
COUNT(*)	SUM(w)
2	18
SELECT COUNT(*) FROM tt;
ERROR 42S02: Table 'test.tt' doesn't exist
FLUSH TABLES;
SELECT COUNT(*), SUM(w) FROM tt2;
COUNT(*)	SUM(w)
2	18
# FLUSH TABLES tt2 / OPTIMIZE / CHECK
OPTIMIZE TABLE tt2;
Table	Op	Msg_type	Msg_text
test.tt2	optimize	status	OK
CHECK TABLE tt2;
Table	Op	Msg_type	Msg_text
test.tt2	check	status	OK
DROP TEMPORARY TABLE tt2;
# Temporary table with encryption options validates the key too
CREATE TEMPORARY TABLE te (ts DATETIME NOT NULL, INDEX(ts)) ENGINE=MooseDB ENCRYPTION='YES' ENCRYPTION_KEY_ID=99;
ERROR HY000: MooseDB: invalid argument: encryption key 99 is not available: encryption: encryption key 99 (version latest) is not available
# Rows survive a flush into a chunk inside the session (200000 rows against
# a 1 MiB MemTable; temporary tables are not listed in INFORMATION_SCHEMA, so
# the spill itself is proven by the equivalent permanent table in statement_atomicity)
CREATE TEMPORARY TABLE big (ts DATETIME NOT NULL, v INT, INDEX(ts)) ENGINE=MooseDB CHUNK_INTERVAL='1 HOUR' MEMTABLE_SIZE=1048576;
INSERT INTO big SELECT '2026-01-01' + INTERVAL seq SECOND, seq FROM seq_1_to_200000;
SELECT COUNT(*), SUM(v), MIN(ts), MAX(ts) FROM big;
COUNT(*)	SUM(v)	MIN(ts)	MAX(ts)
200000	20000100000	2026-01-01 00:00:01	2026-01-03 07:33:20
FLUSH TABLES;
SELECT COUNT(*), SUM(v) FROM big;
COUNT(*)	SUM(v)
200000	20000100000
DROP TEMPORARY TABLE big;
# A session that ends with a temporary table does not leave files behind
connect  con3,localhost,root,,test;
CREATE TEMPORARY TABLE gone (ts DATETIME NOT NULL, v INT, INDEX(ts)) ENGINE=MooseDB;
INSERT INTO gone SELECT '2026-01-01' + INTERVAL seq MINUTE, seq FROM seq_1_to_100;
disconnect con3;
connection default;
leftover temporary table directories: 0 ()
