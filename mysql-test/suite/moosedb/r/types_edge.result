SET NAMES utf8mb4;
# Integer limits of every width
CREATE TABLE ints (
ts   DATETIME NOT NULL,
k    INT NOT NULL,
t1   TINYINT, t1u TINYINT UNSIGNED,
s2   SMALLINT, s2u SMALLINT UNSIGNED,
m3   MEDIUMINT, m3u MEDIUMINT UNSIGNED,
i4   INT, i4u INT UNSIGNED,
b8   BIGINT, b8u BIGINT UNSIGNED,
bt   BIT(64),
INDEX(ts)
) ENGINE=MooseDB;
INSERT INTO ints VALUES
('2026-01-01', 1, -128, 255, -32768, 65535, -8388608, 16777215,
-2147483648, 4294967295, -9223372036854775808, 18446744073709551615, b'1111111111111111111111111111111111111111111111111111111111111111'),
('2026-01-01', 2, 127, 0, 32767, 0, 8388607, 0, 2147483647, 0,
9223372036854775807, 0, b'0'),
('2026-01-01', 3, 0, 1, 0, 1, 0, 1, 0, 1, 0, 9223372036854775808, b'1');
SELECT k, t1, t1u, s2, s2u, m3, m3u, i4, i4u, b8, b8u, BIN(bt) FROM ints ORDER BY k;
k	t1	t1u	s2	s2u	m3	m3u	i4	i4u	b8	b8u	BIN(bt)
1	-128	255	-32768	65535	-8388608	16777215	-2147483648	4294967295	-9223372036854775808	18446744073709551615	1111111111111111111111111111111111111111111111111111111111111111
2	127	0	32767	0	8388607	0	2147483647	0	9223372036854775807	0	0
3	0	1	0	1	0	1	0	1	0	9223372036854775808	1
FLUSH TABLES ints;
SELECT k, t1, t1u, s2, s2u, m3, m3u, i4, i4u, b8, b8u, BIN(bt) FROM ints ORDER BY k;
k	t1	t1u	s2	s2u	m3	m3u	i4	i4u	b8	b8u	BIN(bt)
1	-128	255	-32768	65535	-8388608	16777215	-2147483648	4294967295	-9223372036854775808	18446744073709551615	1111111111111111111111111111111111111111111111111111111111111111
2	127	0	32767	0	8388607	0	2147483647	0	9223372036854775807	0	0
3	0	1	0	1	0	1	0	1	0	9223372036854775808	1
SELECT SUM(b8u), MAX(b8u), MIN(b8) FROM ints;
SUM(b8u)	MAX(b8u)	MIN(b8)
27670116110564327423	18446744073709551615	-9223372036854775808
DROP TABLE ints;
# FLOAT/DOUBLE extremes, negative zero, tiny and huge magnitudes
CREATE TABLE fl (ts DATETIME NOT NULL, k INT NOT NULL, f FLOAT, d DOUBLE, INDEX(ts)) ENGINE=MooseDB;
INSERT INTO fl VALUES
('2026-01-01', 1, 3.402823e38, 1.7976931348623157e308),
('2026-01-01', 2, -3.402823e38, -1.7976931348623157e308),
('2026-01-01', 3, 1.17549435e-38, 2.2250738585072014e-308),
('2026-01-01', 4, 0e0, 0e0),
('2026-01-01', 5, 1e-45, 4.9e-324),
('2026-01-01', 6, 1e30, 1e308),
('2026-01-01', 7, NULL, NULL);
SELECT k, f, d, d = 0 AS is_zero FROM fl ORDER BY k;
k	f	d	is_zero
1	3.40282e38	1.7976931348623157e308	0
2	-3.40282e38	-1.7976931348623157e308	0
3	1.17549e-38	2.2250738585072014e-308	0
4	0	0	1
5	1.4013e-45	5e-324	0
6	1e30	1e308	0
7	NULL	NULL	NULL
FLUSH TABLES fl;
SELECT k, f, d, d = 0 AS is_zero FROM fl ORDER BY k;
k	f	d	is_zero
1	3.40282e38	1.7976931348623157e308	0
2	-3.40282e38	-1.7976931348623157e308	0
3	1.17549e-38	2.2250738585072014e-308	0
4	0	0	1
5	1.4013e-45	5e-324	0
6	1e30	1e308	0
7	NULL	NULL	NULL
# Sign of negative zero is preserved bit for bit
# A computed negative zero must keep its sign, like in a MyISAM control table
CREATE TABLE fl_ctl (k INT, f FLOAT, d DOUBLE) ENGINE=MyISAM;
INSERT INTO fl VALUES ('2026-01-01', 9, 0e0 * -1, 0e0 * -1), ('2026-01-01', 10, 0e0, 0e0);
INSERT INTO fl_ctl VALUES (9, 0e0 * -1, 0e0 * -1), (10, 0e0, 0e0);
FLUSH TABLES fl;
# ATAN2(0, -0) = pi, ATAN2(0, +0) = 0
SELECT fl.k, ATAN2(0e0, fl.d) = ATAN2(0e0, fl_ctl.d) AS same_d, ATAN2(0e0, fl.f) = ATAN2(0e0, fl_ctl.f) AS same_f
FROM fl JOIN fl_ctl ON fl.k = fl_ctl.k ORDER BY fl.k;
k	same_d	same_f
9	1	1
10	1	1
SELECT k, ATAN2(0e0, d) FROM fl WHERE k IN (9, 10) ORDER BY k;
k	ATAN2(0e0, d)
9	0
10	0
DROP TABLE fl_ctl;
SELECT MAX(d), MIN(d), COUNT(d) FROM fl;
MAX(d)	MIN(d)	COUNT(d)
1.7976931348623157e308	-1.7976931348623157e308	8
# Overflow is rejected by the server before reaching the engine
INSERT INTO fl VALUES ('2026-01-01', 8, 1e39, 1);
ERROR 22003: Out of range value for column 'f' at row 1
DROP TABLE fl;
# DECIMAL: exact digits, signs, scale and precision limits
CREATE TABLE dc (ts DATETIME NOT NULL, k INT NOT NULL,
d1 DECIMAL(65,30), d2 DECIMAL(10,0), d3 DECIMAL(18,4) UNSIGNED, INDEX(ts)) ENGINE=MooseDB;
INSERT INTO dc VALUES
('2026-01-01', 1, 12345678901234567890123456789012345.123456789012345678901234567890, 9999999999, 99999999999999.9999),
('2026-01-01', 2, -12345678901234567890123456789012345.123456789012345678901234567890, -9999999999, 0),
('2026-01-01', 3, 0.000000000000000000000000000001, 0, 0.0001),
('2026-01-01', 4, -0.000000000000000000000000000001, -0, 1),
('2026-01-01', 5, NULL, NULL, NULL);
SELECT k, d1, d2, d3 FROM dc ORDER BY k;
k	d1	d2	d3
1	12345678901234567890123456789012345.123456789012345678901234567890	9999999999	99999999999999.9999
2	-12345678901234567890123456789012345.123456789012345678901234567890	-9999999999	0.0000
3	0.000000000000000000000000000001	0	0.0001
4	-0.000000000000000000000000000001	0	1.0000
5	NULL	NULL	NULL
FLUSH TABLES dc;
SELECT k, d1, d2, d3 FROM dc ORDER BY k;
k	d1	d2	d3
1	12345678901234567890123456789012345.123456789012345678901234567890	9999999999	99999999999999.9999
2	-12345678901234567890123456789012345.123456789012345678901234567890	-9999999999	0.0000
3	0.000000000000000000000000000001	0	0.0001
4	-0.000000000000000000000000000001	0	1.0000
5	NULL	NULL	NULL
SELECT k FROM dc WHERE d1 = 0.000000000000000000000000000001;
k
3
SELECT SUM(d3) FROM dc;
SUM(d3)
100000000000001.0000
DROP TABLE dc;
# VARCHAR/TEXT/BLOB: empty, NULL, max length, binary content
CREATE TABLE sv (ts DATETIME NOT NULL, k INT NOT NULL,
v VARCHAR(255) CHARACTER SET latin1, lv VARCHAR(16000) CHARACTER SET latin1,
lt LONGTEXT CHARACTER SET latin1, bl MEDIUMBLOB, INDEX(ts)) ENGINE=MooseDB;
INSERT INTO sv VALUES
('2026-01-01', 1, '', '', '', ''),
('2026-01-01', 2, NULL, NULL, NULL, NULL),
('2026-01-01', 3, REPEAT('a', 255), REPEAT('b', 16000), REPEAT('c', 1000000), REPEAT(X'00FF', 100000)),
('2026-01-01', 4, ' ', ' ', ' ', X'20'),
('2026-01-01', 5, 'trailing  ', 'trailing  ', 'trailing  ', X'0A0D00'),
('2026-01-01', 6, CHAR(0 USING latin1), '', '', X'00');
SELECT k, LENGTH(v), v IS NULL, LENGTH(lv), LENGTH(lt), LENGTH(bl), MD5(CONCAT(IFNULL(lv,''), IFNULL(lt,''), IFNULL(HEX(bl),''))) FROM sv ORDER BY k;
k	LENGTH(v)	v IS NULL	LENGTH(lv)	LENGTH(lt)	LENGTH(bl)	MD5(CONCAT(IFNULL(lv,''), IFNULL(lt,''), IFNULL(HEX(bl),'')))
1	0	0	0	0	0	d41d8cd98f00b204e9800998ecf8427e
2	NULL	1	NULL	NULL	NULL	d41d8cd98f00b204e9800998ecf8427e
3	255	0	16000	1000000	200000	d42d59971acdf1ad905b58962c573659
4	1	0	1	1	1	06069a5a2335ed4bd6664f2421e52869
5	10	0	10	10	3	b55917920c42db878cf676dbe433187e
6	1	0	0	0	1	b4b147bc522828731f1a016bfa72c073
FLUSH TABLES sv;
SELECT k, LENGTH(v), v IS NULL, LENGTH(lv), LENGTH(lt), LENGTH(bl), MD5(CONCAT(IFNULL(lv,''), IFNULL(lt,''), IFNULL(HEX(bl),''))) FROM sv ORDER BY k;
k	LENGTH(v)	v IS NULL	LENGTH(lv)	LENGTH(lt)	LENGTH(bl)	MD5(CONCAT(IFNULL(lv,''), IFNULL(lt,''), IFNULL(HEX(bl),'')))
1	0	0	0	0	0	d41d8cd98f00b204e9800998ecf8427e
2	NULL	1	NULL	NULL	NULL	d41d8cd98f00b204e9800998ecf8427e
3	255	0	16000	1000000	200000	d42d59971acdf1ad905b58962c573659
4	1	0	1	1	1	06069a5a2335ed4bd6664f2421e52869
5	10	0	10	10	3	b55917920c42db878cf676dbe433187e
6	1	0	0	0	1	b4b147bc522828731f1a016bfa72c073
