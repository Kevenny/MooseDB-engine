# utf8mb4 payload: 4-byte characters in ordinary columns
CREATE TABLE u8 (ts DATETIME NOT NULL, k INT NOT NULL, v VARCHAR(64) CHARACTER SET utf8mb4, INDEX(ts)) ENGINE=MooseDB;
INSERT INTO u8 VALUES ('2026-01-01', 1, 'ok 😀 🚀 日本語 ñ'), ('2026-01-01', 2, REPEAT('😀', 64));
SELECT k, v, CHAR_LENGTH(v), LENGTH(v), HEX(LEFT(v, 1)) FROM u8 ORDER BY k;
k	v	CHAR_LENGTH(v)	LENGTH(v)	HEX(LEFT(v, 1))
1	ok 😀 🚀 日本語 ñ	12	25	6F
2	😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀	64	256	F09F9880
FLUSH TABLES u8;
SELECT k, v, CHAR_LENGTH(v), LENGTH(v), HEX(LEFT(v, 1)) FROM u8 ORDER BY k;
k	v	CHAR_LENGTH(v)	LENGTH(v)	HEX(LEFT(v, 1))
1	ok 😀 🚀 日本語 ñ	12	25	6F
2	😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀	64	256	F09F9880
DROP TABLE u8;
# Other column kinds kept as text: DATE/TIME/ENUM/SET/JSON limits
CREATE TABLE ot (ts DATETIME NOT NULL, k INT NOT NULL,
dt DATE, tm TIME(6), e ENUM('a','b','c') NOT NULL, s SET('x','y','z'),
js JSON, yr YEAR, INDEX(ts)) ENGINE=MooseDB;
INSERT INTO ot VALUES
('2026-01-01', 1, '1000-01-01', '-838:59:59.000000', 'c', 'x,z', '{"k": "😀", "n": [1, 2.5, null]}', 1901),
('2026-01-01', 2, '9999-12-31', '838:59:59.999999', 'a', '', '"s"', 2155),
('2026-01-01', 3, NULL, NULL, 'b', NULL, NULL, 0);
SELECT k, dt, tm, e, e+0, s, s+0, js, yr FROM ot ORDER BY k;
k	dt	tm	e	e+0	s	s+0	js	yr
1	1000-01-01	-838:59:59.000000	c	3	x,z	5	{"k": "😀", "n": [1, 2.5, null]}	1901
2	9999-12-31	838:59:59.999999	a	1		0	"s"	2155
3	NULL	NULL	b	2	NULL	NULL	NULL	0000
FLUSH TABLES ot;
SELECT k, dt, tm, e, e+0, s, s+0, js, yr FROM ot ORDER BY k;
k	dt	tm	e	e+0	s	s+0	js	yr
1	1000-01-01	-838:59:59.000000	c	3	x,z	5	{"k": "😀", "n": [1, 2.5, null]}	1901
2	9999-12-31	838:59:59.999999	a	1		0	"s"	2155
3	NULL	NULL	b	2	NULL	NULL	NULL	0000
DROP TABLE ot;
# Extreme time-axis values and microsecond precision (DATETIME)
CREATE TABLE tx (ts DATETIME(6) NOT NULL, k INT NOT NULL, INDEX(ts)) ENGINE=MooseDB CHUNK_INTERVAL='1 HOUR';
INSERT INTO tx VALUES
('1000-01-01 00:00:00.000000', 1),
('1000-01-01 00:00:00.000001', 2),
('1969-12-31 23:59:59.999999', 3),
