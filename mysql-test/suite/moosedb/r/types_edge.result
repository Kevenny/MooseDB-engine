# Fractional-second precision is whatever the column declares
CREATE TABLE tp (ts DATETIME(3) NOT NULL, k INT NOT NULL, INDEX(ts)) ENGINE=MooseDB;
INSERT INTO tp VALUES ('2026-01-01 00:00:00.1234', 1), ('2026-01-01 00:00:00.9996', 2), ('2026-01-01 00:00:00.0005', 3);
SELECT k, ts FROM tp ORDER BY ts, k;
k	ts
3	2026-01-01 00:00:00.000
1	2026-01-01 00:00:00.123
2	2026-01-01 00:00:00.999
FLUSH TABLES tp;
SELECT k, ts FROM tp ORDER BY ts, k;
k	ts
3	2026-01-01 00:00:00.000
1	2026-01-01 00:00:00.123
2	2026-01-01 00:00:00.999
DROP TABLE tp;
