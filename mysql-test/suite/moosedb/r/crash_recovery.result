CREATE TABLE t (ts DATETIME(6) NOT NULL, host VARCHAR(8) NOT NULL COMMENT 'TAG', v INT, INDEX(ts))
ENGINE=MooseDB CHUNK_INTERVAL='1 HOUR';
# Part of the rows sealed in chunks, the rest only in the WAL
INSERT INTO t SELECT ts + INTERVAL 1 DAY, host, v + 1000 FROM t;
SELECT COUNT(*), SUM(v) FROM t;
COUNT(*)	SUM(v)
200	109900
# kill -9 the server
# Kill the server
# restart
SELECT COUNT(*), SUM(v) FROM t;
COUNT(*)	SUM(v)
200	109900
SELECT host, COUNT(*) FROM t GROUP BY host ORDER BY host;
host	COUNT(*)
h0	50
h1	50
h2	50
h3	50
SELECT COUNT(*) FROM t WHERE ts >= '2026-10-02';
COUNT(*)
100
# Writes continue after recovery and survive another crash
INSERT INTO t VALUES ('2026-10-03 00:00:00', 'h9', 1);
# Kill the server
# restart
SELECT COUNT(*), SUM(v) FROM t;
COUNT(*)	SUM(v)
201	109901
CHECK TABLE t;
Table	Op	Msg_type	Msg_text
test.t	check	status	OK
DROP TABLE t;
